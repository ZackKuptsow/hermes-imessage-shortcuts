    {
      "id": "e19f6ca8-5b75-4282-8b40-ce9d2a213bbd",
      "name": "Route by sender",
      "parameters": {
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "dropped"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "65200158-1547-4d73-b001-c87505a68a5b",
                    "leftValue": "={{ $json.zack_handles.includes(((s) => s.includes('@') ? s.toLowerCase() : ((d) => /^\\d{10}$/.test(d) ? '+1' + d : /^1\\d{10}$/.test(d) ? '+' + d : d)(s.replace(/[\\s().\\-]/g, '')))(String($json.body.sender).trim())) }}",
                    "operator": {
                      "name": "filter.operator.true",
                      "operation": "true",
                      "singleValue": true,
                      "type": "boolean"
                    },
                    "rightValue": ""
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 4
                }
              },
              "outputKey": "zack",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        448,
        0
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5
    },
