    {
      "alwaysOutputData": true,
      "id": "9ee8cca6-95c4-4e03-ab59-191952c7ba51",
      "name": "Find an accepted run",
      "parameters": {
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "__RUN_RECORD_TABLE_ID__"
        },
        "filters": {
          "conditions": [
            {
              "condition": "eq",
              "keyName": "route",
              "keyValue": "zack"
            },
            {
              "condition": "eq",
              "keyName": "outcome",
              "keyValue": "accepted"
            },
            {
              "condition": "gt",
              "keyName": "createdAt",
              "keyValue": "={{ $now.minus({ hours: $json.quiet_hours }).toISO() }}"
            }
          ]
        },
        "limit": 1,
        "matchType": "allConditions",
        "operation": "get"
      },
      "position": [
        448,
        -112
      ],
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1
    },
    {
