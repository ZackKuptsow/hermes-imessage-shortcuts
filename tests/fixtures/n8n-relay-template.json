  "name": "iMessage relay",
  "nodes": [
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "Shortcuts relay secret"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Relay webhook",
      "parameters": {
        "authentication": "headerAuth",
        "httpMethod": "POST",
        "options": {
          "ipWhitelist": "127.0.0.1,::1"
        },
        "path": "imessage-relay",
        "responseMode": "onReceived"
      },
      "position": [
        0,
        0
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1
    },
    {
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Routing table",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1000000-0000-4000-8000-000000000001",
              "name": "zack_handles",
              "type": "array",
              "value": "__ZACK_HANDLES_JSON__"
            },
            {
              "id": "b1000000-0000-4000-8000-000000000002",
              "name": "received_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "b1000000-0000-4000-8000-000000000003",
              "name": "started_ms",
              "type": "number",
              "value": "={{ $now.toMillis() }}"
            }
          ]
        },
        "include": "selected",
        "includeFields": "body",
        "includeOtherFields": true,
        "options": {}
      },
      "position": [
        220,
        0
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Route by sender",
      "parameters": {
        "mode": "rules",
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "dropped"
        },
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "c1000000-0000-4000-8000-000000000001",
                    "leftValue": "={{ $json.zack_handles.includes(((s) => s.includes('@') ? s.toLowerCase() : ((d) => /^\\d{10}$/.test(d) ? '+1' + d : /^1\\d{10}$/.test(d) ? '+' + d : d)(s.replace(/[\\s().\\-]/g, '')))(String($json.body.sender).trim())) }}",
                    "operator": {
                      "name": "filter.operator.true",
                      "operation": "true",
                      "singleValue": true,
                      "type": "boolean"
                    },
                    "rightValue": ""
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                }
              },
              "outputKey": "zack",
              "renameOutput": true
            }
          ]
        }
      },
      "position": [
        440,
        0
      ],
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "Hermes iMessage plugin secret"
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Forward to plugin",
      "onError": "continueErrorOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ $json.body }}",
        "method": "POST",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 5000
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "http://127.0.0.1:8645/imessage"
      },
      "position": [
        660,
        -100
      ],
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2
    },
    {
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Record forward",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2000000-0000-4000-8000-000000000001",
              "name": "route",
              "type": "string",
              "value": "zack"
            },
            {
              "id": "b2000000-0000-4000-8000-000000000002",
              "name": "outcome",
              "type": "string",
              "value": "={{ ({202: 'accepted', 204: 'dropped_by_plugin', 401: 'secret_refused'})[$json.statusCode] ?? 'plugin_refusing' }}"
            },
            {
              "id": "b2000000-0000-4000-8000-000000000003",
              "name": "plugin_status",
              "type": "number",
              "value": "={{ $json.statusCode }}"
            },
            {
              "id": "b2000000-0000-4000-8000-000000000004",
              "name": "received_at",
              "type": "string",
              "value": "={{ $('Routing table').first().json.received_at }}"
            },
            {
              "id": "b2000000-0000-4000-8000-000000000005",
              "name": "duration_ms",
              "type": "number",
              "value": "={{ $now.toMillis() - $('Routing table').first().json.started_ms }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        880,
        -200
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Record failure",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b3000000-0000-4000-8000-000000000001",
              "name": "route",
              "type": "string",
              "value": "zack"
            },
            {
              "id": "b3000000-0000-4000-8000-000000000002",
              "name": "outcome",
              "type": "string",
              "value": "={{ /timeout|TIMEDOUT/.test(String($json.error?.message) + ' ' + String($json.error?.code)) ? 'timeout' : 'plugin_unreachable' }}"
            },
            {
              "id": "b3000000-0000-4000-8000-000000000003",
              "name": "received_at",
              "type": "string",
              "value": "={{ $('Routing table').first().json.received_at }}"
            },
            {
              "id": "b3000000-0000-4000-8000-000000000004",
              "name": "duration_ms",
              "type": "number",
              "value": "={{ $now.toMillis() - $('Routing table').first().json.started_ms }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        880,
        0
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Record drop",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b4000000-0000-4000-8000-000000000001",
              "name": "route",
              "type": "string",
              "value": "dropped"
            },
            {
              "id": "b4000000-0000-4000-8000-000000000002",
              "name": "outcome",
              "type": "string",
              "value": "dropped"
            },
            {
              "id": "b4000000-0000-4000-8000-000000000003",
              "name": "received_at",
              "type": "string",
              "value": "={{ $json.received_at }}"
            },
            {
              "id": "b4000000-0000-4000-8000-000000000004",
              "name": "duration_ms",
              "type": "number",
              "value": "={{ $now.toMillis() - $json.started_ms }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        660,
        200
      ],
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4
    },
    {
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Insert run record",
      "parameters": {
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "schema": [],
          "value": {
            "duration_ms": "={{ $json.duration_ms }}",
            "outcome": "={{ $json.outcome }}",
            "plugin_status": "={{ $json.plugin_status }}",
            "received_at": "={{ $json.received_at }}",
            "route": "={{ $json.route }}"
          }
        },
        "dataTableId": {
          "__rl": true,
          "mode": "list",
          "value": "__RUN_RECORD_TABLE_ID__"
        },
        "operation": "insert",
        "options": {},
        "resource": "row"
      },
      "position": [
        1100,
